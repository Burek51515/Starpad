# Solana Network
NETWORK=devnet
RPC_URL=https://api.devnet.solana.com
# For mainnet: https://api.mainnet-beta.solana.com
# Or use a paid RPC like Helius, QuickNode, etc.

# Program ID (will be set after deployment)
PROGRAM_ID=

# Platform wallet (receives fees)
PLATFORM_WALLET=

# Database (Supabase or PostgreSQL)
SUPABASE_URL=
SUPABASE_KEY=
# Or PostgreSQL:
DATABASE_URL=postgresql://user:password@localhost:5432/pump_platform

# API Server
PORT=3000
WS_PORT=8080

# File Upload (optional - S3, Cloudflare R2, or IPFS)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_BUCKET=
AWS_REGION=

# IPFS (alternative)
IPFS_PROJECT_ID=
IPFS_PROJECT_SECRET=
