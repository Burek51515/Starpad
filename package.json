{
  "name": "pump-platform",
  "version": "1.0.0",
  "description": "Complete Pump.fun-style launchpad on Solana",
  "main": "index.js",
  "scripts": {
    "build": "anchor build",
    "test": "anchor test",
    "deploy": "anchor deploy",
    "deploy-devnet": "anchor deploy --provider.cluster devnet",
    "api": "ts-node src/api-backend.ts",
    "dev": "concurrently \"npm run api\" \"cd website && npx serve .\"",
    "start": "npm run api"
  },
  "keywords": [
    "solana",
    "pump-fun",
    "launchpad",
    "bonding-curve",
    "dex"
  ],
  "author": "Pump Platform Team",
  "license": "MIT",
  "dependencies": {
    "@solana/web3.js": "^1.87.6",
    "@solana/spl-token": "^0.3.11",
    "@project-serum/anchor": "^0.29.0",
    "@supabase/supabase-js": "^2.39.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "ws": "^8.16.0",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/ws": "^8.5.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "concurrently": "^8.2.2"
  }
}
